# Copy to .env. Never commit real values.
DATABASE_URL=postgresql://crimelens:crimelens_dev_only@localhost:5432/crimelens
POSTGRES_PASSWORD=crimelens_dev_only
INGEST_INTERVAL_MINUTES=30
CRAWLER_CONTACT=
# Geocoding provider and LLM adapter are optional and unset until configured.
# Approximate locations for drafts. 'nominatim' needs CRAWLER_CONTACT set (the public service requires an identifying contact). Leave empty to disable.
GEOCODER_PROVIDER=
GEOCODER_URL=
LLM_EXTRACTION_ENABLED=false
PORT=4000
CORS_ORIGIN=http://localhost:3000
# Admin API is disabled unless this is set to 32+ random characters (e.g. `openssl rand -hex 32`).
ADMIN_JWT_SECRET=
TRUST_PROXY_HOPS=0
# Optional LLM extraction (OFF by default). Enabling it sends document text to the Anthropic API; decide that deliberately.
LLM_PROVIDER=
ANTHROPIC_API_KEY=
LLM_MODEL=
# Gemini: set LLM_PROVIDER=gemini. Press notes contain names and addresses. On Google's free tier it may use what you send to improve its products,
# so first enable billing on the Google Cloud project for this key, then set GEMINI_BILLING_CONFIRMED=true. GEMINI_MODEL has no default: use a current model name from Google AI Studio.
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_BILLING_CONFIRMED=false
