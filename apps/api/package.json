{
  "name": "@crimelens/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "start": "tsx --env-file-if-exists=../../.env src/server.ts",
    "db:setup": "tsx --env-file-if-exists=../../.env src/cli.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "worker": "tsx --env-file-if-exists=../../.env src/worker.ts",
    "source:enable": "tsx --env-file-if-exists=../../.env src/enable-source.ts",
    "admin:create": "tsx --env-file-if-exists=../../.env src/create-admin.ts",
    "import": "tsx --env-file-if-exists=../../.env src/import-cli.ts",
    "seed:dev": "tsx --env-file-if-exists=../../.env src/dev-seed-cli.ts",
    "ingest:once": "tsx --env-file-if-exists=../../.env src/ingest-once.ts",
    "fix-tls": "tsx src/tls-fix-cli.ts"
  },
  "dependencies": {
    "@crimelens/shared": "*",
    "cors": "2.8.5",
    "express": "4.21.1",
    "express-rate-limit": "7.4.1",
    "helmet": "8.0.0",
    "pg": "8.13.1",
    "zod": "3.23.8",
    "tsx": "4.19.2",
    "cheerio": "1.0.0",
    "jsonwebtoken": "9.0.2",
    "csv-parse": "5.5.6",
    "unpdf": "1.9.0"
  },
  "devDependencies": {
    "@types/cors": "2.8.17",
    "@types/express": "4.17.21",
    "@types/node": "22.9.0",
    "@types/pg": "8.11.10",
    "@types/supertest": "6.0.2",
    "supertest": "7.0.0",
    "typescript": "5.6.3",
    "vitest": "2.1.8",
    "@types/jsonwebtoken": "9.0.7"
  },
  "engines": {
    "node": ">=22.9"
  }
}
